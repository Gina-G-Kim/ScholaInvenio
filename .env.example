# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# OpenAlex API key — free at https://openalex.org/settings/api
# Without one: 100 requests/day. With one: 10,000/day. Effectively required.
OPENALEX_API_KEY=

# Optional: contact email OpenAlex uses for the "polite pool" when no key is set.
OPENALEX_MAILTO=
